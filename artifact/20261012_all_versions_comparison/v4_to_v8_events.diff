+        while True:
+            used[j0]=True;i0=p[j0];delta=float('inf');j1=0
+            for j in range(1,m+1):
+                if not used[j]:
+                    cur=float(cost[i0-1,j-1])-u[i0]-v[j]
+                    if cur<mins[j]:mins[j]=cur;way[j]=j0
